+
+/// Combine several command results into one: success only if all succeeded.
+fn merge_command_results(results: Vec<CommandResult>) -> CommandResult {
+    let mut merged = CommandResult {
+        code: Some(0),
+        stdout: String::new(),
+        stderr: String::new(),
+    };
+    for result in results {
+        if !result.success() {
+            merged.code = result.code.or(Some(1));
+        }
+        for (target, text) in [
+            (&mut merged.stdout, result.stdout),
+            (&mut merged.stderr, result.stderr),
+        ] {
+            if !text.trim().is_empty() {
+                if !target.is_empty() {
+                    target.push('\n');
+                }
+                target.push_str(text.trim_end());
+            }
+        }
+    }
+    merged
 }
 
