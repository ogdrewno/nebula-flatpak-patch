@@ -0,0 +1,505 @@
+//! Flatpak support.
+//!
+//! Flatpak applications live alongside XBPS packages in Nebula's lists. To keep
+//! the rest of the code base (which identifies packages by name) unchanged, a
+//! Flatpak app is stored with the name `flatpak:<app-id>`. The XBPS command
+//! wrappers check for that prefix and hand the work over to this module.
+//!
+//! Everything here shells out to the `flatpak` command line tool. If it is not
+//! installed, Flatpak support silently switches itself off.
+
+use std::collections::{HashMap, HashSet};
+use std::process::Command;
+
+use once_cell::sync::Lazy;
+
+use crate::details::{DiscoverDetail, InstalledDetail};
+use crate::types::{CommandResult, PackageInfo, lowercase_cache};
+
+pub(crate) const PREFIX: &str = "flatpak:";
+
+pub(crate) fn is_flatpak_name(name: &str) -> bool {
+    name.starts_with(PREFIX)
+}
+
+/// `flatpak:org.gimp.GIMP` -> `org.gimp.GIMP`; other names are returned as-is.
+pub(crate) fn strip_prefix(name: &str) -> &str {
+    name.strip_prefix(PREFIX).unwrap_or(name)
+}
+
+pub(crate) fn key_for(app_id: &str) -> String {
+    format!("{}{}", PREFIX, app_id)
+}
+
+/// Split a list of package names into (xbps, flatpak app ids).
+pub(crate) fn partition_names(names: &[String]) -> (Vec<String>, Vec<String>) {
+    let mut xbps = Vec::new();
+    let mut flatpak = Vec::new();
+    for name in names {
+        if is_flatpak_name(name) {
+            flatpak.push(strip_prefix(name).to_string());
+        } else {
+            xbps.push(name.clone());
+        }
+    }
+    (xbps, flatpak)
+}
+
+static AVAILABLE: Lazy<bool> = Lazy::new(|| {
+    Command::new("flatpak")
+        .arg("--version")
+        .output()
+        .map(|out| out.status.success())
+        .unwrap_or(false)
+});
+
+/// Whether the `flatpak` tool is installed on this system.
+pub(crate) fn is_available() -> bool {
+    *AVAILABLE
+}
+
+fn flatpak_command() -> Command {
+    let mut command = Command::new("flatpak");
+    // Output is parsed, so it must not be translated.
+    command.env("LC_ALL", "C");
+    command.env("LANG", "C");
+    command
+}
+
+fn run_capture(args: &[&str]) -> Result<CommandResult, String> {
+    let output = flatpak_command()
+        .args(args)
+        .output()
+        .map_err(|err| format!("Failed to launch flatpak: {}", err))?;
+    Ok(CommandResult {
+        code: output.status.code(),
+        stdout: String::from_utf8_lossy(&output.stdout).to_string(),
+        stderr: String::from_utf8_lossy(&output.stderr).to_string(),
+    })
+}
+
+fn new_package(
+    app_id: &str,
+    display_name: &str,
+    version: &str,
+    description: &str,
+    installed: bool,
+    origin: Option<String>,
+) -> PackageInfo {
+    let name = key_for(app_id);
+    let version = version.trim().to_string();
+    let description = description.trim().to_string();
+    let display_name = display_name.trim();
+    // Make the friendly name searchable/filterable too.
+    let searchable = if display_name.is_empty() {
+        description.clone()
+    } else {
+        format!("{} {}", display_name, description)
+    };
+    PackageInfo {
+        name_lower: lowercase_cache(&name),
+        version_lower: lowercase_cache(&version),
+        description_lower: lowercase_cache(&searchable),
+        name,
+        version,
+        description,
+        installed,
+        pinned: false,
+        previous_version: None,
+        download_size: None,
+        changelog: None,
+        download_bytes: None,
+        repository: origin.map(|o| format!("Flatpak ({})", o)),
+        build_date: None,
+        first_seen: None,
+        display_name: if display_name.is_empty() {
+            None
+        } else {
+            Some(display_name.to_string())
+        },
+    }
+}
+
+/// Split one line of tab-separated `flatpak --columns=` output.
+fn split_columns(line: &str) -> Vec<&str> {
+    line.split('\t').map(|c| c.trim()).collect()
+}
+
+fn looks_like_app_id(value: &str) -> bool {
+    // Reverse-DNS: at least two dots, no spaces.
+    !value.is_empty() && !value.contains(' ') && value.matches('.').count() >= 2
+}
+
+// ---------------------------------------------------------------------------
+// Search
+// ---------------------------------------------------------------------------
+
+const SEARCH_COLUMNS: &str = "--columns=application,name,description,version,remotes";
+
+pub(crate) fn parse_search_output(output: &str) -> Vec<PackageInfo> {
+    let mut seen = HashSet::new();
+    let mut packages = Vec::new();
+    for line in output.lines() {
+        let cols = split_columns(line);
+        if cols.len() < 2 {
+            continue;
+        }
+        let app_id = cols[0];
+        // Skips the header row (printed on a terminal) and "No matches found".
+        if !looks_like_app_id(app_id) {
+            continue;
+        }
+        if !seen.insert(app_id.to_string()) {
+            continue;
+        }
+        let display_name = cols.get(1).copied().unwrap_or("");
+        let description = cols.get(2).copied().unwrap_or("");
+        let version = cols.get(3).copied().unwrap_or("");
+        let origin = cols
+            .get(4)
+            .and_then(|r| r.split(',').next())
+            .map(|r| r.trim().to_string())
+            .filter(|r| !r.is_empty());
+        packages.push(new_package(
+            app_id,
+            display_name,
+            version,
+            description,
+            false,
+            origin,
+        ));
+    }
+    packages
+}
+
+/// Search the configured Flatpak remotes. Returns an empty list when Flatpak
+/// is not installed.
+pub(crate) fn search(query: &str) -> Result<Vec<PackageInfo>, String> {
+    if !is_available() {
+        return Ok(Vec::new());
+    }
+    let result = run_capture(&["search", SEARCH_COLUMNS, query])?;
+    if !result.success() {
+        return Err(result.stderr.trim().to_string());
+    }
+    Ok(parse_search_output(&result.stdout))
+}
+
+// ---------------------------------------------------------------------------
+// Installed apps
+// ---------------------------------------------------------------------------
+
+const LIST_COLUMNS: &str = "--columns=application,name,description,version,origin";
+
+pub(crate) fn parse_list_output(output: &str) -> Vec<PackageInfo> {
+    let mut seen = HashSet::new();
+    let mut packages = Vec::new();
+    for line in output.lines() {
+        let cols = split_columns(line);
+        if cols.is_empty() {
+            continue;
+        }
+        let app_id = cols[0];
+        if !looks_like_app_id(app_id) || !seen.insert(app_id.to_string()) {
+            continue;
+        }
+        let display_name = cols.get(1).copied().unwrap_or("");
+        let description = cols.get(2).copied().unwrap_or("");
+        let version = cols.get(3).copied().unwrap_or("");
+        let origin = cols.get(4).map(|o| o.to_string()).filter(|o| !o.is_empty());
+        packages.push(new_package(
+            app_id,
+            display_name,
+            version,
+            description,
+            true,
+            origin,
+        ));
+    }
+    packages
+}
+
+/// Installed Flatpak applications (user and system installations).
+pub(crate) fn list_installed() -> Result<Vec<PackageInfo>, String> {
+    if !is_available() {
+        return Ok(Vec::new());
+    }
+    let result = run_capture(&["list", "--app", LIST_COLUMNS])?;
+    if !result.success() {
+        return Err(result.stderr.trim().to_string());
+    }
+    Ok(parse_list_output(&result.stdout))
+}
+
+// ---------------------------------------------------------------------------
+// Install / uninstall
+// ---------------------------------------------------------------------------
+
+/// Find which remote provides `app_id` (first match wins).
+fn remote_for(app_id: &str) -> Option<String> {
+    let result = run_capture(&["search", "--columns=application,remotes", app_id]).ok()?;
+    if !result.success() {
+        return None;
+    }
+    result.stdout.lines().find_map(|line| {
+        let cols = split_columns(line);
+        if cols.first().copied() == Some(app_id) {
+            cols.get(1)
+                .and_then(|r| r.split(',').next())
+                .map(|r| r.trim().to_string())
+                .filter(|r| !r.is_empty())
+        } else {
+            None
+        }
+    })
+}
+
+/// Install a Flatpak app system-wide. Authorisation is handled by Flatpak
+/// itself through polkit, so no pkexec is needed.
+pub(crate) fn install(app_id: &str) -> Result<CommandResult, String> {
+    let remote = remote_for(app_id);
+    let mut args = vec!["install", "--system", "-y", "--noninteractive"];
+    if let Some(remote) = remote.as_deref() {
+        args.push(remote);
+    }
+    args.push(app_id);
+    run_capture(&args)
+}
+
+pub(crate) fn uninstall(app_ids: &[String]) -> Result<CommandResult, String> {
+    if app_ids.is_empty() {
+        return Ok(CommandResult {
+            code: Some(0),
+            stdout: String::new(),
+            stderr: String::new(),
+        });
+    }
+    let mut args: Vec<&str> = vec!["uninstall", "-y", "--noninteractive"];
+    args.extend(app_ids.iter().map(|s| s.as_str()));
+    run_capture(&args)
+}
+
+// ---------------------------------------------------------------------------
+// Details
+// ---------------------------------------------------------------------------
+
+#[derive(Default, Debug)]
+pub(crate) struct FlatpakInfo {
+    pub title: Option<String>,
+    pub summary: Option<String>,
+    pub fields: HashMap<String, String>,
+}
+
+/// Parse `flatpak info` / `flatpak remote-info` output:
+///
+/// ```text
+/// GIMP - Create images and edit photographs
+///
+///           ID: org.gimp.GIMP
+///      Version: 2.10.38
+///      License: GPL-3.0+
+///       Origin: flathub
+///    Installed: 1.2 GB
+/// ```
+pub(crate) fn parse_info_output(output: &str) -> FlatpakInfo {
+    let mut info = FlatpakInfo::default();
+    let mut saw_header = false;
+    for line in output.lines() {
+        let trimmed = line.trim();
+        if trimmed.is_empty() {
+            continue;
+        }
+        if !saw_header {
+            saw_header = true;
+            if !trimmed.contains(": ") || trimmed.contains(" - ") {
+                match trimmed.split_once(" - ") {
+                    Some((title, summary)) => {
+                        info.title = Some(title.trim().to_string());
+                        info.summary = Some(summary.trim().to_string());
+                    }
+                    None => info.title = Some(trimmed.to_string()),
+                }
+                continue;
+            }
+        }
+        if let Some((key, value)) = trimmed.split_once(':') {
+            let key = key.trim();
+            let value = value.trim();
+            if !key.is_empty() {
+                info.fields.insert(key.to_string(), value.to_string());
+            }
+        }
+    }
+    info
+}
+
+/// Convert "1.2 GB" / "350.5 MB" / "12 kB" (as printed by Flatpak) to bytes.
+pub(crate) fn parse_human_size(value: &str) -> Option<u64> {
+    let value = value.trim().replace('\u{a0}', " ");
+    let (number, unit) = match value.split_once(' ') {
+        Some((n, u)) => (n.trim(), u.trim()),
+        None => {
+            let idx = value.find(|c: char| c.is_alphabetic())?;
+            (value[..idx].trim(), value[idx..].trim())
+        }
+    };
+    let number: f64 = number.replace(',', ".").parse().ok()?;
+    let multiplier: f64 = match unit.to_ascii_lowercase().as_str() {
+        "b" | "bytes" | "byte" => 1.0,
+        "kb" => 1e3,
+        "mb" => 1e6,
+        "gb" => 1e9,
+        "tb" => 1e12,
+        "kib" => 1024.0,
+        "mib" => 1024.0 * 1024.0,
+        "gib" => 1024.0 * 1024.0 * 1024.0,
+        _ => return None,
+    };
+    Some((number * multiplier).round() as u64)
+}
+
+fn homepage_for(app_id: &str, origin: Option<&str>) -> Option<String> {
+    match origin {
+        Some(o) if o.eq_ignore_ascii_case("flathub") => {
+            Some(format!("https://flathub.org/apps/{}", app_id))
+        }
+        _ => None,
+    }
+}
+
+pub(crate) fn installed_detail(app_id: &str) -> Result<InstalledDetail, String> {
+    let result = run_capture(&["info", app_id])?;
+    if !result.success() {
+        return Err(result.stderr.trim().to_string());
+    }
+    let info = parse_info_output(&result.stdout);
+    let mut detail = InstalledDetail::default();
+    detail.long_description = info.summary.clone();
+    detail.license = info.fields.get("License").cloned();
+    detail.homepage = homepage_for(app_id, info.fields.get("Origin").map(|s| s.as_str()));
+    detail.maintainer = info
+        .fields
+        .get("Origin")
+        .map(|o| format!("Flatpak remote: {}", o));
+    if let Some(size) = info.fields.get("Installed") {
+        detail.download_bytes = parse_human_size(size);
+        detail.download_formatted = Some(size.clone());
+    }
+    Ok(detail)
+}
+
+pub(crate) fn discover_detail(app_id: &str) -> Result<DiscoverDetail, String> {
+    let remote = remote_for(app_id)
+        .ok_or_else(|| format!("Could not find \"{}\" in any Flatpak remote.", app_id))?;
+    let result = run_capture(&["remote-info", &remote, app_id])?;
+    if !result.success() {
+        return Err(result.stderr.trim().to_string());
+    }
+    let info = parse_info_output(&result.stdout);
+    let mut detail = DiscoverDetail::default();
+    detail.version = info.fields.get("Version").cloned();
+    detail.description = info.summary.clone();
+    detail.license = info.fields.get("License").cloned();
+    detail.repository = Some(format!("Flatpak ({})", remote));
+    detail.homepage = homepage_for(app_id, Some(&remote));
+    if let Some(size) = info.fields.get("Download") {
+        detail.download_bytes = parse_human_size(size);
+        detail.download = Some(size.clone());
+    }
+    Ok(detail)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn prefix_helpers() {
+        assert!(is_flatpak_name("flatpak:org.gimp.GIMP"));
+        assert!(!is_flatpak_name("gimp"));
+        assert_eq!(strip_prefix("flatpak:org.gimp.GIMP"), "org.gimp.GIMP");
+        assert_eq!(strip_prefix("gimp"), "gimp");
+        let (x, f) = partition_names(&["gimp".to_string(), "flatpak:org.gimp.GIMP".to_string()]);
+        assert_eq!(x, vec!["gimp"]);
+        assert_eq!(f, vec!["org.gimp.GIMP"]);
+    }
+
+    #[test]
+    fn parses_search_without_header() {
+        let out = "org.gimp.GIMP\tGNU Image Manipulation Program\tCreate images and edit photographs\t2.10.38\tflathub\n\
+                   org.gimp.GIMP\tGNU Image Manipulation Program\tCreate images and edit photographs\t2.10.38\tflathub-beta\n\
+                   io.github.foo.Bar\tBar\t\t\tflathub,other\n";
+        let pkgs = parse_search_output(out);
+        assert_eq!(pkgs.len(), 2);
+        assert_eq!(pkgs[0].name, "flatpak:org.gimp.GIMP");
+        assert_eq!(pkgs[0].title(), "GNU Image Manipulation Program");
+        assert_eq!(pkgs[0].version, "2.10.38");
+        assert_eq!(pkgs[0].repository.as_deref(), Some("Flatpak (flathub)"));
+        assert!(!pkgs[0].installed);
+        assert!(pkgs[0].description_lower.contains("gnu image"));
+        assert_eq!(pkgs[1].repository.as_deref(), Some("Flatpak (flathub)"));
+    }
+
+    #[test]
+    fn parses_search_with_header_and_no_matches() {
+        let out = "Application ID\tName\tDescription\tVersion\tRemotes\n\
+                   org.mozilla.firefox\tFirefox\tFast, Private & Safe Web Browser\t133.0\tflathub\n";
+        let pkgs = parse_search_output(out);
+        assert_eq!(pkgs.len(), 1);
+        assert_eq!(pkgs[0].title(), "Firefox");
+        assert!(parse_search_output("No matches found\n").is_empty());
+    }
+
+    #[test]
+    fn parses_list() {
+        let out = "com.github.tchx84.Flatseal\tFlatseal\tManage Flatpak permissions\t2.3.0\tflathub\n\
+                   org.freedesktop.Platform\tFreedesktop Platform\t\t24.08\tflathub\n";
+        let pkgs = parse_list_output(out);
+        assert_eq!(pkgs.len(), 2);
+        assert!(pkgs[0].installed);
+        assert!(pkgs[0].is_flatpak());
+        assert_eq!(pkgs[0].title(), "Flatseal");
+    }
+
+    #[test]
+    fn parses_info() {
+        let out = "\nGIMP - Create images and edit photographs\n\n\
+                   \x20         ID: org.gimp.GIMP\n\
+                   \x20        Ref: app/org.gimp.GIMP/x86_64/stable\n\
+                   \x20    Version: 2.10.38\n\
+                   \x20    License: GPL-3.0+ AND LGPL-3.0+\n\
+                   \x20     Origin: flathub\n\
+                   \x20  Installed: 1.2 GB\n";
+        let info = parse_info_output(out);
+        assert_eq!(info.title.as_deref(), Some("GIMP"));
+        assert_eq!(
+            info.summary.as_deref(),
+            Some("Create images and edit photographs")
+        );
+        assert_eq!(
+            info.fields.get("Version").map(String::as_str),
+            Some("2.10.38")
+        );
+        assert_eq!(
+            info.fields.get("Origin").map(String::as_str),
+            Some("flathub")
+        );
+        assert_eq!(
+            info.fields.get("Installed").map(String::as_str),
+            Some("1.2 GB")
+        );
+        assert_eq!(
+            info.fields.get("Ref").map(String::as_str),
+            Some("app/org.gimp.GIMP/x86_64/stable")
+        );
+    }
+
+    #[test]
+    fn parses_sizes() {
+        assert_eq!(parse_human_size("1.2 GB"), Some(1_200_000_000));
+        assert_eq!(parse_human_size("350.5 MB"), Some(350_500_000));
+        assert_eq!(parse_human_size("12\u{a0}kB"), Some(12_000));
+        assert_eq!(parse_human_size("7 bytes"), Some(7));
+        assert_eq!(parse_human_size("?"), None);
+    }
+}
